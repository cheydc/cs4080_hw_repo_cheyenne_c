// loop_closure_test.lox
// Demonstrates Challenge 2: each loop iteration gets its own variable.
//
// Without the fix: both closures capture the same `i`, so both print 3
// (the value of i after the loop exits).
//
// With the fix: each closure captures its own copy of i, so they print
// 1 and 2 respectively.

var first;
var second;

for (var i = 1; i <= 2; i = i + 1) {
  var capture = i;   // without Challenge 2, this workaround is needed
  if (first == nil) {
    fun c() { print i; }   // captures the per-iteration i directly
    first = c;
  } else {
    fun c() { print i; }
    second = c;
  }
}

first();    // should print 1 (not 3)
second();   // should print 2 (not 3)