// montecarlo.lox
// Estimates pi using the Monte Carlo method.
// Drops random points in a 1x1 square and checks how many land
// inside the quarter circle of radius 1. The ratio approximates pi/4.
// Uses: random(), sqrt(), clock()

var samples = 100000;
var inside = 0;
var i = 0;

var start = clock();

while (i < samples) {
  var x = random();
  var y = random();
  if (sqrt(x * x + y * y) < 1) {
    inside = inside + 1;
  }
  i = i + 1;
}

var pi = 4 * inside / samples;
print pi;
print clock() - start;